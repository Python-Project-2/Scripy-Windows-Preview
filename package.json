{
  "name": "scripy-windows-preview",
  "displayName": "Scripy Windows Preview",
  "description": "Preview your Android device on Windows right from VS Code. Great for Flutter development. Simple scrcpy and ADB manager.",
  "version": "1.0.0",
  "publisher": "dwidevelopes",
  "author": "dwidevelopes",
  "license": "MIT",
  "icon": "icon/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwidevelopes"
  },
  "keywords": [
    "flutter",
    "dart",
    "scripy",
    "scrcpy",
    "windows",
    "preview",
    "android",
    "adb",
    "mirror",
    "manager",
    "simple"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Debuggers",
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/pubspec.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scripy-windows-preview",
          "title": "Scripy Preview",
          "icon": "icon/main.png"
        }
      ]
    },
    "views": {
      "scripy-windows-preview": [
        {
          "type": "webview",
          "id": "scripy-windows-preview.main",
          "name": "Scripy Preview",
          "icon": "icon/main.png"
        }
      ]
    },
    "commands": [
      {
        "command": "scripy-windows-preview.run",
        "title": "Run scrcpy",
        "category": "Scripy"
      },
      {
        "command": "scripy-windows-preview.stop",
        "title": "Stop scrcpy",
        "category": "Scripy"
      }
    ],
    "configuration": {
      "title": "Scripy Preview",
      "properties": {
        "scripyPreview.dock": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "none"
          ],
          "enumDescriptions": [
            "Dock the phone window to the left edge of the screen.",
            "Dock the phone window to the right edge of the screen.",
            "Do not position the window (scrcpy default)."
          ],
          "default": "right",
          "description": "Where the scrcpy phone window is placed when it starts."
        },
        "scripyPreview.alwaysOnTop": {
          "type": "boolean",
          "default": true,
          "description": "Keep the scrcpy window above other windows so it stays visible while you code."
        },
        "scripyPreview.screenScale": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Display scale used to position the window (for example 1.25 or 1.5). 0 = detect automatically. Change it only if the window lands in the wrong place."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}